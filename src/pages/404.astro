---
import { Nav, SiteFooter } from '@components/site';
import { Button, Pill } from '@components/ui';
import Layout from '@layouts/Layout.astro';
import { sections } from '@lib/sections';
import { m } from '@paraglide/messages.js';

const metaData = {
    title: m.not_found_title(),
    description: m.not_found_description(),
    noindex: true
};
---

<Layout metaData={metaData}>
    <Nav slot="header" />
    <div
        class="mx-auto flex max-w-280 grow flex-col items-center justify-center px-4 py-16 text-center sm:px-8"
    >
        <p
            aria-hidden="true"
            class="text-[96px] leading-none font-extrabold tracking-[-0.03em] sm:text-[140px]"
        >
            404
        </p>
        <h1
            class="mt-4 text-[32px] leading-tight font-extrabold sm:text-[42px]"
        >
            {m.not_found_title()}
        </h1>
        <p class="text-muted mt-3 max-w-[46ch] text-[17px] leading-[1.65]">
            {m.not_found_description()}
        </p>
        <div class="mt-8">
            <Button href="/">{m.not_found_home()}</Button>
        </div>
        <p class="text-muted mt-12 text-[15px] font-semibold">
            {m.not_found_suggestions()}
        </p>
        <ul class="mt-4 flex flex-wrap justify-center gap-3">
            {
                sections.map((section) => (
                    <li>
                        <Pill tone={section.tone} href={section.href}>
                            {section.label()}
                        </Pill>
                    </li>
                ))
            }
        </ul>
    </div>
    <SiteFooter slot="footer" />
</Layout>
