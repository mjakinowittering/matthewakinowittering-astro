---
import Button from '@components/block/Button.astro';
import { m } from '@paraglide/messages.js';
import { Image } from 'astro:assets';
import Alien from '../assets/alien.svg';
import Layout from '../layouts/Layout.astro';

const metaData = {
    title: m.not_found_title(),
    description: m.not_found_description()
};
---

<Layout metaData={metaData}>
    <div class="flex min-h-screen items-center justify-center text-center">
        <div class="m-5 flex flex-col items-center">
            <Image
                src={Alien}
                alt={m.not_found_image_alt()}
                class="size-48"
                loading="eager"
            />
            <div class="flex w-full flex-col gap-3">
                <h1 class="text-3xl font-extrabold">{metaData.title}</h1>
                <p class="text-muted text-lg">
                    {metaData.description}
                </p>
            </div>
            <div class="w-full py-5">
                <Button href="/">{m.not_found_run_away()}</Button>
            </div>
        </div>
    </div>
</Layout>
