---
import { Nav, SiteFooter } from '@components/site';
import { Button, Pill } from '@components/ui';
import Layout from '@layouts/Layout.astro';
import { sections } from '@lib/sections';
import { m } from '@paraglide/messages.js';

const metaData = {
    title: m.not_found_title(),
    description: m.not_found_description(),
    noindex: true
};
---

<Layout metaData={metaData}>
    <Nav slot="header" progress={false} />
    <div
        class="mx-auto flex max-w-[688px] flex-col items-center gap-5 px-5 pt-18 pb-22 text-center sm:px-6 sm:pt-28 sm:pb-32"
    >
        <p
            aria-hidden="true"
            class="text-[112px] leading-[0.9] font-extrabold tracking-tighter sm:text-[160px]"
        >
            404
        </p>
        <h1
            class="mt-2 text-[32px] leading-[1.1] font-extrabold tracking-[-0.02em] sm:text-[40px]"
        >
            {m.not_found_title()}
        </h1>
        <p class="text-muted max-w-[40ch] text-[19px]">
            {m.not_found_description()}
        </p>
        <div class="mt-2 flex">
            <Button href="/" size="lg">{m.not_found_home()}</Button>
        </div>
        <nav
            aria-label={m.nav_sections()}
            class="flex flex-col items-center gap-3 pt-6"
        >
            <p class="text-muted text-[14px] font-bold">
                {m.not_found_suggestions()}
            </p>
            <ul class="flex flex-wrap justify-center gap-2.5">
                {
                    sections.map((section) => (
                        <li class="flex">
                            <Pill tone={section.tone} href={section.href}>
                                {section.label()}
                            </Pill>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
    <SiteFooter slot="footer" ruled />
</Layout>
