---
import Nav from '@components/block/Nav.astro';
import SiteFooter from '@components/block/SiteFooter.astro';
import Experience from '@components/home/experience/index.astro';
import Education from '@components/home/experience/topics/education/index.astro';
import Employment from '@components/home/experience/topics/employment/index.astro';
import Training from '@components/home/experience/topics/training/index.astro';
import Hero from '@components/home/hero/index.astro';
import Projects from '@components/home/projects/index.astro';
import WhatIdo from '@components/home/what-do-i-do/index.astro';
import { m } from '@paraglide/messages.js';
import Layout from '../layouts/Layout.astro';
import { getCareerStart } from '../lib/career';
import { calcLengthInYears } from '../lib/utils';

const metaData = {
    description: m.site_description({
        experience: calcLengthInYears(await getCareerStart(), new Date())
    }),
    additionalMetaTags: [
        {
            name: 'google-site-verification',
            content: 'F_gIghpXfLjo0LORq-3zJ1HjUIlKmy2iTb9lWQD_BfM'
        }
    ]
};
---

<Layout metaData={metaData}>
    <Nav slot="header" />
    <Hero />
    <Projects />
    <Experience />
    <WhatIdo />
    <Employment />
    <Education />
    <Training />
    <SiteFooter slot="footer" />
</Layout>
