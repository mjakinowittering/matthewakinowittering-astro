---
import { ExternalTextLink, Tag } from '@components/ui';
import { m } from '@paraglide/messages.js';
import type { CollectionEntry } from 'astro:content';

interface Props {
    gist: CollectionEntry<'gists'>;
}

const { gist } = Astro.props;
const { title, filename, language, uri } = gist.data;
---

<li
    class="border-hairline flex flex-wrap items-center justify-between gap-x-5 gap-y-2.5 px-5 py-4 not-first:border-t sm:px-7 sm:py-4.5"
>
    <span class="flex min-w-0 basis-full flex-col gap-0.5 sm:flex-[1_1_320px]">
        <span class="font-semibold">{title}</span>
        <span class="text-muted text-[14px]">{filename}</span>
    </span>
    <span class="inline-flex items-center gap-3.5">
        <Tag>{language}</Tag>
        <ExternalTextLink
            href={uri}
            arrow
            class="link text-[15px] font-semibold"
        >
            <span aria-hidden="true">{m.projects_gists_view()}</span>
            <span class="sr-only">{m.projects_gists_view_for({ title })}</span>
        </ExternalTextLink>
    </span>
</li>
