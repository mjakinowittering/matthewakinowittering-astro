---
import { ExternalTextLink, Icon } from '@components/ui';
import { ArrowDown01Icon } from '@hugeicons/core-free-icons';
import { formatMonthYear } from '@lib/utils';
import { m } from '@paraglide/messages.js';
import type { CollectionEntry } from 'astro:content';

interface Props {
    organisation: CollectionEntry<'organisations'>;
    // Newest first
    courses: CollectionEntry<'events'>[];
    // Its place in the list, shown as 01, 02…
    number: number;
    // Only the first provider starts open
    open: boolean;
}

const { organisation, courses, number, open } = Astro.props;

const summary = m.learning_provider_summary({
    courses: m.learning_courses({ count: courses.length }),
    date: formatMonthYear(courses[0].data.dateFrom)
});
---

<details class="group" open={open}>
    <summary
        class="box-content flex min-h-11 cursor-pointer list-none items-center gap-3.5 px-5 py-4.5 sm:gap-5 sm:px-7 sm:py-5.5 [&::-webkit-details-marker]:hidden"
    >
        {
            // The list already numbers it for a screen reader
        }
        <span
            aria-hidden="true"
            class="text-muted w-7 flex-none text-[15px] font-extrabold"
        >
            {String(number).padStart(2, '0')}
        </span>
        <span
            class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-3.5 gap-y-1"
        >
            <span class="text-[22px] font-extrabold tracking-[-0.02em]">
                {organisation.data.name}
            </span>
            <span class="text-muted text-[14px]">{summary}</span>
        </span>
        <span
            class="border-ink box-content inline-flex size-9 flex-none items-center justify-center rounded-full border-[1.5px] group-open:rotate-180 motion-safe:transition-transform"
        >
            <Icon icon={ArrowDown01Icon} class="size-4.5" />
        </span>
    </summary>
    <ol class="flex flex-col pr-5 pb-4.5 pl-[62px] sm:pr-7 sm:pb-5 sm:pl-19">
        {
            courses.map(({ data }) => (
                <li class="border-hairline flex flex-col items-start gap-1 py-2.5 not-first:border-t sm:flex-row sm:flex-wrap sm:items-stretch sm:justify-between sm:gap-x-4 sm:gap-y-0.5">
                    <span class="font-semibold">{data.title}</span>
                    <span class="text-muted inline-flex items-center gap-2.5 text-[14px]">
                        {formatMonthYear(data.dateFrom)}
                        {data.uri && (
                            <ExternalTextLink
                                href={data.uri}
                                arrow
                                class="link text-[13.5px] font-semibold"
                            >
                                <span aria-hidden="true">
                                    {m.learning_certificate()}
                                </span>
                                <span class="sr-only">
                                    {m.learning_certificate_for({
                                        course: data.title
                                    })}
                                </span>
                            </ExternalTextLink>
                        )}
                    </span>
                </li>
            ))
        }
    </ol>
</details>
