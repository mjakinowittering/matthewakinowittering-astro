---
import { Button, Card } from '@components/ui';
import { m } from '@paraglide/messages.js';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { img, alt, title, description, tags, uri, sourceUri } = project.data;

// The image() schema types `format` as optional, though Astro always sets it
// and <Image> requires it; narrowing here keeps the type honest without a cast
const src = img?.format ? { ...img, format: img.format } : undefined;

const screenshot =
    'border-ink rounded-button aspect-[1200/630] w-full border-[1.5px] object-cover';
---

<Card class="flex w-full flex-col p-5 sm:p-6">
    {
        src ? (
            <Image src={src} alt={alt ?? title} class={screenshot} />
        ) : (
            <div
                class:list={[
                    screenshot,
                    'text-muted flex items-center justify-center bg-[repeating-linear-gradient(135deg,var(--color-rule)_0,var(--color-rule)_2px,transparent_2px,transparent_14px)] p-5 text-center text-[13px] font-semibold'
                ]}
            >
                {m.projects_screenshot_placeholder()}
            </div>
        )
    }
    <h3 class="mt-6 text-[24px] leading-tight font-extrabold">{title}</h3>
    <p class="text-muted mt-3 text-[15px] leading-[1.65]">{description}</p>
    <div class="mt-auto pt-6">
        <ul class="flex flex-wrap gap-2">
            {
                tags.map((tag) => (
                    <li class="border-ink bg-base rounded-full border-[1.5px] px-3 py-0.5 text-[13px] font-semibold">
                        {tag}
                    </li>
                ))
            }
        </ul>
        <div class="mt-6 flex flex-wrap gap-4">
            <Button href={uri} external>
                {m.projects_try_live()}
            </Button>
            {
                sourceUri && (
                    <Button href={sourceUri} variant="ghost" external>
                        {m.projects_view_source()}
                    </Button>
                )
            }
        </div>
    </div>
</Card>
