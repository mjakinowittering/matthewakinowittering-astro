---
import Pill from '@components/block/Pill.astro';

interface Props {
    // The section's pill label and its index-card colour
    pill: string;
    tone: 'yellow' | 'blue' | 'green' | 'pink' | 'teal';
    title: string;
}

const { pill, tone, title } = Astro.props;
---

<div>
    <Pill tone={tone}>{pill}</Pill>
    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
        <h2
            class="text-[32px] leading-[1.1] font-extrabold tracking-[-0.01em] sm:text-[42px]"
        >
            {title}
        </h2>
        <slot />
    </div>
</div>
