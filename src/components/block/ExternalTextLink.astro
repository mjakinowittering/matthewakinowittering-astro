---
import Icon from '@components/block/Icon.astro';
import { ArrowUpRight01Icon } from '@hugeicons/core-free-icons';
import { m } from '@paraglide/messages.js';

interface Props {
    href: string;
    size?: 'sm' | 'md';
    // Replaces the default content link style, for links styled as pills or nav
    class?: string;
}

const { href, size = 'md', class: className } = Astro.props;

const iconSizes = {
    sm: 'size-3.5',
    md: 'size-4'
};
---

<a
    class:list={['inline-flex items-center gap-1', className ?? 'link']}
    href={href}
    target="_blank"
    rel="noopener"
>
    <span><slot /></span>
    <span class="sr-only">{m.external_new_tab()}</span>
    <Icon
        icon={ArrowUpRight01Icon}
        class:list={['inline flex-none', iconSizes[size]]}
    />
</a>
