---
import Icon from '@components/block/Icon.astro';
import { Cancel01Icon, Menu01Icon } from '@hugeicons/core-free-icons';
import { m } from '@paraglide/messages.js';

// Rooted at `/`, so they work from the 404 page as well as the home page
const navLinks = [
    { label: m.nav_projects, href: '/#projects' },
    { label: m.nav_how_i_work, href: '/#how-i-work' },
    { label: m.nav_career, href: '/#career' },
    { label: m.nav_learning, href: '/#learning' }
];

const linkClass =
    'text-ink decoration-accent decoration-[2.5px] underline-offset-4 no-underline hover:underline';
---

<header
    class="group border-ink bg-card h-header sticky top-0 z-20 border-b-[1.5px]"
>
    <nav
        class="mx-auto flex h-full max-w-280 items-center justify-between px-4 sm:px-8"
    >
        <a href="/" class="text-ink text-[16px] font-extrabold no-underline">
            {m.site_name()}
        </a>
        <ul
            class="nav:flex hidden items-center gap-7 text-[15px] font-semibold"
        >
            {
                navLinks.map((link) => (
                    <li>
                        <a href={link.href} class={linkClass}>
                            {link.label()}
                        </a>
                    </li>
                ))
            }
        </ul>
        <button
            type="button"
            popovertarget="nav-menu"
            class="border-ink bg-card text-ink shadow-offset-sm rounded-button nav:hidden inline-flex items-center gap-1.5 border-[1.5px] px-3 py-1.5 text-sm font-bold"
        >
            <Icon
                icon={Menu01Icon}
                class="size-4 group-has-[:popover-open]:hidden"
            />
            <Icon
                icon={Cancel01Icon}
                class="hidden size-4 group-has-[:popover-open]:inline"
            />
            {m.nav_menu()}
        </button>
        <div
            id="nav-menu"
            popover
            class="border-ink bg-card top-header nav:hidden inset-x-0 bottom-auto m-0 w-full max-w-none border-b-[1.5px] px-4 py-2 text-[16px] font-semibold"
        >
            <ul class="flex flex-col">
                {
                    navLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class:list={[linkClass, 'block py-3']}
                            >
                                {link.label()}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </nav>
    <div
        aria-hidden="true"
        class="scroll-progress bg-accent absolute inset-x-0 bottom-[-1.5px] h-1"
    >
    </div>
</header>

<script>
    // Following a link in the phone menu closes it; without this script the
    // menu still closes with Escape or a tap outside.
    const menu = document.getElementById('nav-menu');
    menu?.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) {
            menu.hidePopover();
        }
    });
</script>
