---
import ExternalTextLink from '@components/block/ExternalTextLink.astro';
import { m } from '@paraglide/messages.js';
import { socials } from '../../lib/socials';

const navLinks = [
    { label: m.nav_about, href: '#about' },
    { label: m.nav_career, href: '#career' },
    { label: m.nav_projects, href: '#projects' },
    { label: m.nav_education, href: '#education' }
];
---

<header class="border-border bg-bg sticky top-0 z-20 border-b">
    <nav class="flex items-center justify-between px-8 py-4">
        <span class="text-sm font-bold">{m.site_name()}</span>
        <div class="flex items-center gap-6">
            <div
                class="text-muted hidden items-center gap-6.5 text-[13px] font-semibold sm:flex"
            >
                {
                    navLinks.map((link) => (
                        <a href={link.href} class="hover:text-ink no-underline">
                            {link.label()}
                        </a>
                    ))
                }
            </div>
            <div
                class="text-muted flex items-center gap-3.5 text-[13px] font-semibold"
            >
                {
                    socials.map((social) => (
                        <ExternalTextLink
                            href={social.href}
                            size="sm"
                            class="hover:text-ink no-underline"
                        >
                            {social.label()}
                        </ExternalTextLink>
                    ))
                }
            </div>
        </div>
    </nav>
</header>
