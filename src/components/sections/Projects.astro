---
import { Project } from '@components/entries';
import { Doodle, Icon, Section, SectionHead } from '@components/ui';
import { Idea01Icon, Moon02Icon } from '@hugeicons/core-free-icons';
import { m } from '@paraglide/messages.js';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(function (a, b) {
    return a.data.index - b.data.index;
});
---

<Section id="projects" alt>
    <Doodle icon={Idea01Icon} position="top-left" />
    <SectionHead
        pill={m.nav_projects()}
        tone="yellow"
        title={m.projects_title()}
    >
        <p class="font-marker inline-flex -rotate-3 items-center gap-2 text-xl">
            {m.projects_marker()}
            <Icon icon={Moon02Icon} class="size-6" />
        </p>
    </SectionHead>
    <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {
            projects.map((project) => (
                <li class="flex">
                    <Project project={project} />
                </li>
            ))
        }
    </ul>
</Section>
