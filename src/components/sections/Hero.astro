---
import Avatar from '@assets/MatthewAkinoWittering-BW-Alpha.png';
import { Button, Card, Section } from '@components/ui';
import { formatAccomplishment, getAccomplishments } from '@lib/accomplishments';
import { getCareerStart } from '@lib/career';
import { calcLengthInYears } from '@lib/utils';
import { m } from '@paraglide/messages.js';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';

const blurb = await getEntry('blurbs', 'hero');

if (!blurb) return Astro.redirect('/404');

const { Content } = await render(blurb);

const accomplishments = await getAccomplishments();

const sticker = m.hero_sticker({
    years: calcLengthInYears(await getCareerStart(), new Date())
});

// The sticker's outline: a 20-point starburst in a 100 by 100 box
const starburst = Array.from({ length: 40 }, (_, i) => {
    const radius = i % 2 ? 43 : 49;
    const angle = (Math.PI * i) / 20;
    return `${50 + radius * Math.sin(angle)},${50 - radius * Math.cos(angle)}`;
}).join(' ');
---

<Section>
    <div class="grid items-center gap-12 md:grid-cols-[1.3fr_.7fr]">
        <div>
            <h1
                class="text-[40px] leading-[1.05] font-extrabold tracking-[-0.02em] sm:text-[58px]"
            >
                {blurb.data.title}
                <span
                    class="font-marker mt-2 block font-normal tracking-normal"
                >
                    {m.hero_marker()}
                </span>
            </h1>
            <div
                class="prose text-muted prose-p:text-[17px] prose-p:leading-[1.65] prose-p:text-muted sm:prose-p:text-[19px] mt-6 max-w-[56ch]"
            >
                {Content ? <Content /> : <p>{m.content_not_found()}</p>}
            </div>
            <div class="mt-8 flex flex-wrap gap-4">
                <Button href="#projects">{m.hero_see_projects()}</Button>
                <Button href="#contact" variant="ghost">
                    {m.hero_get_in_touch()}
                </Button>
            </div>
        </div>
        <div
            class="relative mx-auto w-64 pt-8 sm:w-80 md:mx-0 md:justify-self-end"
        >
            <Card class="overflow-hidden">
                <Image
                    src={Avatar}
                    alt={m.hero_photo_alt({ name: m.site_name() })}
                    loading="eager"
                    class="w-full"
                />
            </Card>
            <p
                class="text-ink absolute -top-2 -right-4 flex size-32 -rotate-12 items-center justify-center text-center text-[15px] leading-tight font-extrabold sm:-right-8"
            >
                <svg
                    aria-hidden="true"
                    viewBox="0 0 100 100"
                    class="fill-ic-apricot stroke-ink absolute inset-0 size-full"
                >
                    <polygon
                        points={starburst}
                        stroke-width="1.5"
                        vector-effect="non-scaling-stroke"></polygon>
                </svg>
                <span class="relative max-w-[11ch]">{sticker}</span>
            </p>
        </div>
    </div>
    <ul class="mt-14 grid gap-4 sm:grid-cols-3">
        {
            accomplishments.map(({ data }) => (
                <Card as="li" class="p-6">
                    <p class="text-muted text-[15px] leading-normal">
                        <span class="font-marker text-ink block text-[40px] leading-tight">
                            {formatAccomplishment(data.value, data.suffix)}
                        </span>
                        {data.caption}
                    </p>
                </Card>
            ))
        }
    </ul>
</Section>
