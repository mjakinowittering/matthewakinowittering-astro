---
import { m } from '@paraglide/messages.js';
import { getCareerStart } from '../../lib/career';
import { calcLengthInYears, formatMonthYear } from '../../lib/utils';

const dateFrom = await getCareerStart();
---

<time
    datetime={dateFrom.toISOString()}
    title={m.duration_since({ date: formatMonthYear(dateFrom) })}
    >{calcLengthInYears(dateFrom, new Date())}</time
>
