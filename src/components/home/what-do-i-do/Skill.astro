---
import Icon from '@components/block/Icon.astro';
import {
    Compass01Icon,
    Search01Icon,
    SourceCodeIcon
} from '@hugeicons/core-free-icons';
import { m } from '@paraglide/messages.js';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
    entry: CollectionEntry<'skills'>;
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const icons = { 1: Compass01Icon, 2: Search01Icon, 3: SourceCodeIcon } as const;
const icon = icons[entry.data.index as keyof typeof icons] ?? Compass01Icon;
---

<div class="border-border bg-bg rounded-lg border p-6.5">
    <div
        class="border-border bg-panel text-accent-strong mb-3.5 flex size-9.5 items-center justify-center rounded-full border"
    >
        <Icon icon={icon} class="size-4.5" />
    </div>
    <h3 class="mb-2.5 text-lg font-bold">{entry.data.title}</h3>
    <div
        class="prose text-muted prose-p:text-[13.5px] prose-p:leading-[1.6] prose-p:text-muted"
    >
        {Content ? <Content /> : <p>{m.content_not_found()}</p>}
    </div>
</div>
