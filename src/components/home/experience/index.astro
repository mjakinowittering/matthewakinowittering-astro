---
import Badge from '@components/block/Badge.astro';
import Icon from '@components/block/Icon.astro';
import Section from '@components/block/Section.astro';
import SectionHead from '@components/block/SectionHead.astro';
import { Clock01Icon } from '@hugeicons/core-free-icons';
import { m } from '@paraglide/messages.js';
import { getEntry, render } from 'astro:content';

const blurb = await getEntry('blurbs', 'experience');

if (!blurb) return Astro.redirect('/404');

const { Content } = await render(blurb);
---

<Section alt>
    <SectionHead title={blurb.data.title} subtitle={blurb.data.subtitle}>
        <Badge slot="badge" label={m.experience_badge()}>
            <Icon icon={Clock01Icon} class="size-6.5" />
        </Badge>
    </SectionHead>
    <div
        class="prose text-muted prose-p:text-[17px] prose-p:leading-[1.65] prose-p:text-muted mt-5 max-w-[70ch]"
    >
        {Content ? <Content /> : <p>{m.content_not_found()}</p>}
    </div>
</Section>
