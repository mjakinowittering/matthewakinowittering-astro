---
import EventDescription from '@components/block/EventDescription.svelte';
import ExternalTextLink from '@components/block/ExternalTextLink.astro';
import { m } from '@paraglide/messages.js';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { format } from 'date-fns';

interface Props {
    event: CollectionEntry<'events'>;
}

const { event } = Astro.props;

const { Content } = await render(event);

const { title, uri, dateFrom, dateTo } = event.data;

const ongoing = !dateTo;

const eventDates = { dateFrom, dateTo };

const range = m.date_range({
    from: format(dateFrom, 'yyyy'),
    to: dateTo ? format(dateTo, 'yyyy') : m.date_present()
});
---

<div class="text-muted flex items-baseline gap-2 text-[13px] font-bold">
    <span class="text-ink">
        {title}
    </span>
    ·
    <span>
        {range}
    </span>
    ·
    <span>
        {
            ongoing ? (
                <EventDescription client:only="svelte" {...eventDates} />
            ) : (
                <EventDescription {...eventDates} />
            )
        }
    </span>
</div>
<div
    class="prose text-muted prose-p:text-sm prose-p:leading-[1.6] prose-p:text-muted mt-2 max-w-[64ch]"
>
    {Content ? <Content /> : <p>{m.content_not_found()}</p>}
</div>
{
    uri && (
        <div class="text-accent-strong mt-2.5 text-[13px] font-semibold">
            <ExternalTextLink href={uri} size="sm">
                {m.education_view_course()}
            </ExternalTextLink>
        </div>
    )
}
