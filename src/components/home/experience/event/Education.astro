---
import ExternalTextLink from '@components/block/ExternalTextLink.astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { format } from 'date-fns';
import EventDescription from './EventDescription.svelte';

interface Props {
    event: CollectionEntry<'events'>;
}

const { event } = Astro.props;

const { Content } = await render(event);

const { title, uri, dateFrom, dateTo } = event.data;

const range = `${format(dateFrom, 'yyyy')} – ${
    dateTo ? format(dateTo, 'yyyy') : 'Present'
}`;
---

<div class="text-muted flex items-baseline gap-2 text-[13px] font-bold">
    <span class="text-ink">
        {title}
    </span>
    ·
    <span>
        {range}
    </span>
    ·
    <span>
        <EventDescription client:only="svelte" {dateFrom} {dateTo} />
    </span>
</div>
<div
    class="prose text-muted prose-p:text-sm prose-p:leading-[1.6] prose-p:text-muted mt-2 max-w-[64ch]"
>
    {Content ? <Content /> : <p>Content not found</p>}
</div>
{
    uri && (
        <div class="text-accent-strong mt-2.5 text-[13px] font-semibold">
            <ExternalTextLink href={uri} size="sm">
                View course
            </ExternalTextLink>
        </div>
    )
}
