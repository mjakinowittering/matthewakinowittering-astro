---
import Button from '@components/block/Button.astro';
import { m } from '@paraglide/messages.js';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { img, alt, title, description, tags, uri, sourceUri } = project.data;

// The image() schema types `format` as optional, though Astro always sets it
// and <Image> requires it; narrowing here keeps the type honest without a cast
const src = img?.format ? { ...img, format: img.format } : undefined;
---

<div
    class="border-border bg-bg grid overflow-hidden rounded-lg border md:grid-cols-2"
>
    {
        src ? (
            <Image
                src={src}
                alt={alt ?? title}
                class="size-full object-cover"
            />
        ) : (
            <div class="text-muted flex min-h-65 items-center justify-center bg-[repeating-linear-gradient(135deg,var(--color-border)_0,var(--color-border)_2px,transparent_2px,transparent_14px)] p-5 text-center font-mono text-[11px] tracking-[0.06em] uppercase">
                {m.projects_screenshot_placeholder()}
            </div>
        )
    }
    <div class="flex flex-col gap-3.5 p-8">
        <h3 class="text-2xl font-bold">{title}</h3>
        <p class="text-muted text-[15px] leading-[1.6]">{description}</p>
        <div class="flex flex-wrap gap-2">
            {
                tags.map((tag) => (
                    <span class="bg-accent-soft text-accent-strong rounded-full px-2.5 py-1.25 text-[10.5px] font-bold tracking-[0.04em] uppercase">
                        {tag}
                    </span>
                ))
            }
        </div>
        <div class="mt-1.5 flex flex-wrap gap-3">
            <Button href={uri} external>
                {m.projects_try_live()}
            </Button>
            {
                sourceUri && (
                    <Button href={sourceUri} variant="ghost" external>
                        {m.projects_view_source()}
                    </Button>
                )
            }
        </div>
    </div>
</div>
