---
import { Icon } from '@components/ui';
import {
    Cancel01Icon,
    Mail01Icon,
    Menu01Icon
} from '@hugeicons/core-free-icons';
import { sections } from '@lib/sections';
import { email, socials } from '@lib/socials';
import { m } from '@paraglide/messages.js';

interface Props {
    // The reading-progress bar along the top; the 404 page goes without
    progress?: boolean;
}

const { progress = true } = Astro.props;

const navLinks = sections.filter((section) => section.inNav);

const linkClass =
    'text-ink no-underline decoration-2 underline-offset-[6px] hover:underline';

// The header's square buttons: the socials, email and the menu button
const square =
    'border-ink bg-card text-ink shadow-offset-sm rounded-button hover:shadow-offset-press inline-flex size-11 items-center justify-center border-[1.5px] motion-safe:transition-transform motion-safe:hover:translate-y-0.5';
---

<!--
    Below 900px the script sets data-hidden as the reader scrolls down, and the
    inner part slides up behind the bar, which stays pinned. The header itself
    is transparent, so the page shows through once the inner part has gone.
-->
<header
    id="site-header"
    class="group max-nav:data-hidden:pointer-events-none sticky top-0 z-20"
>
    {
        progress && (
            <div
                id="site-progress"
                aria-hidden="true"
                class="bg-base relative z-10 pt-[env(safe-area-inset-top)]"
            >
                <div class="bg-rule h-1">
                    <div class="scroll-progress bg-accent h-1" />
                </div>
            </div>
        )
    }
    <div
        id="site-header-inner"
        class="border-ink bg-base max-nav:group-data-hidden:-translate-y-full border-b-[1.5px] motion-safe:transition-transform motion-safe:duration-200"
    >
        <div
            class="max-w-page mx-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-3.5"
        >
            <a
                href="/"
                class="text-ink text-[19px] font-extrabold tracking-[-0.02em] no-underline"
            >
                {m.site_name()}
            </a>
            <nav aria-label={m.nav_sections()} class="nav:block hidden">
                <ul
                    class="flex flex-wrap gap-x-5.5 gap-y-1.5 text-[15px] font-semibold"
                >
                    {
                        navLinks.map((link) => (
                            <li>
                                <a href={link.href} class={linkClass}>
                                    {link.label()}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
            <ul class="hidden gap-2.5 sm:flex">
                {
                    socials.map((social) => (
                        <li class="flex">
                            <a
                                href={social.href}
                                target="_blank"
                                rel="noopener"
                                aria-label={`${social.label()} ${m.external_new_tab()}`}
                                class={square}
                            >
                                <Icon icon={social.icon} class="size-5" />
                            </a>
                        </li>
                    ))
                }
                <li class="flex">
                    <a
                        href={`mailto:${email}`}
                        aria-label={m.social_email()}
                        class={square}
                    >
                        <Icon icon={Mail01Icon} class="size-5" />
                    </a>
                </li>
            </ul>
            <button
                type="button"
                popovertarget="nav-menu"
                aria-label={m.nav_menu()}
                class:list={[square, 'nav:hidden cursor-pointer']}
            >
                <Icon
                    icon={Menu01Icon}
                    class="size-5.5 group-has-[:popover-open]:hidden"
                />
                <Icon
                    icon={Cancel01Icon}
                    class="hidden size-5.5 group-has-[:popover-open]:inline"
                />
            </button>
            <nav
                id="nav-menu"
                popover
                aria-label={m.nav_sections()}
                class:list={[
                    'border-ink bg-base nav:hidden inset-x-0 bottom-auto m-0 w-full max-w-none border-b-[1.5px] px-6 py-2 text-[16px] font-semibold',
                    progress
                        ? 'top-header'
                        : 'top-[calc(var(--spacing-header)-4px)]'
                ]}
            >
                <ul class="flex flex-col">
                    {
                        navLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class:list={[linkClass, 'block py-3']}
                                >
                                    {link.label()}
                                </a>
                            </li>
                        ))
                    }
                    {
                        // Below 640px the header has no room for its social
                        // buttons, so the menu carries them
                        socials.map((social) => (
                            <li class="sm:hidden">
                                <a
                                    href={social.href}
                                    target="_blank"
                                    rel="noopener"
                                    class:list={[linkClass, 'block py-3']}
                                >
                                    {social.label()}
                                    <span class="sr-only">
                                        {m.external_new_tab()}
                                    </span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>
    </div>
</header>

<script>
    const header = document.getElementById('site-header');
    const inner = document.getElementById('site-header-inner');
    const bar = document.getElementById('site-progress');
    const menu = document.getElementById('nav-menu');

    // Below 900px, where the menu button shows (the `nav` breakpoint)
    const phone = matchMedia('(width < 56.25rem)');

    // Movement under this many pixels is ignored, so nudges and momentum
    // bounces never make the header flicker
    const tolerance = 10;

    // Following a link in the phone menu closes it; without this script the
    // menu still closes with Escape or a tap outside.
    menu?.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) {
            menu.hidePopover();
        }
    });

    function setHidden(hidden: boolean) {
        header?.toggleAttribute('data-hidden', hidden);
    }

    // Hide on a downward scroll, show on an upward one, measured from the last
    // point the header changed or held still. CSS only acts on it below 900px.
    let lastY = 0;
    let queued = false;

    function update() {
        queued = false;
        const maxY = document.documentElement.scrollHeight - innerHeight;
        // Clamped, so rubber-banding past either end never reads as a direction
        const y = Math.min(Math.max(scrollY, 0), maxY);
        if (y < (inner?.offsetHeight ?? 0)) {
            setHidden(false);
        } else if (y - lastY >= tolerance) {
            if (!menu?.matches(':popover-open')) setHidden(true);
        } else if (lastY - y >= tolerance) {
            setHidden(false);
        } else {
            return;
        }
        lastY = y;
    }

    addEventListener(
        'scroll',
        () => {
            if (!queued) {
                queued = true;
                requestAnimationFrame(update);
            }
        },
        { passive: true }
    );

    // Focus anywhere in the header reveals it, so nothing focused is off-screen
    header?.addEventListener('focusin', () => setHidden(false));

    // An in-page link should land its section just below whatever will be
    // showing at the top: on a phone, the bar alone when the jump goes down
    // (the header hides on the way) and the whole header when it goes up.
    // Above 900px the stylesheet's scroll-padding-top is always right.
    document.addEventListener('click', (event) => {
        const root = document.documentElement;
        root.style.removeProperty('scroll-padding-top');
        if (!phone.matches || !(event.target instanceof Element)) return;
        const link = event.target.closest('a');
        if (!link?.hash || link.pathname !== location.pathname) return;
        const target = document.getElementById(link.hash.slice(1));
        if (!target) return;
        const barHeight = bar?.offsetHeight ?? 0;
        const goingDown = target.getBoundingClientRect().top > barHeight;
        const padding = goingDown
            ? barHeight
            : barHeight + (inner?.offsetHeight ?? 0);
        root.style.scrollPaddingTop = `${padding}px`;
    });
</script>
