---
import { m } from '@paraglide/messages.js';

interface Props {
    href: string;
    variant?: 'primary' | 'ghost';
    external?: boolean;
}

const { href, variant = 'primary', external = false } = Astro.props;

// An outlined card on a hard ink edge; pressing it sinks it onto a smaller one
const base =
    'border-ink text-ink shadow-offset rounded-button active:shadow-offset-sm inline-flex items-center gap-2 border-[1.5px] px-5 py-3 text-[15px] font-bold no-underline active:translate-y-px motion-safe:transition-transform motion-safe:hover:-translate-y-px';

const variants = {
    primary: 'bg-accent',
    ghost: 'bg-card'
};
---

<a
    href={href}
    class:list={[base, variants[variant]]}
    {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
    <slot />
    {external && <span class="sr-only">{m.external_new_tab()}</span>}
</a>
