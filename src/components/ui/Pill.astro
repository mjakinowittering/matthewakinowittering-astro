---
interface Props {
    // Each section's index-card colour, used for nothing else
    tone: 'yellow' | 'blue' | 'green' | 'pink' | 'teal';
    // A pill that goes somewhere, as on the 404 page
    href?: string;
}

const { tone, href } = Astro.props;

const tones = {
    yellow: 'bg-ic-yellow',
    blue: 'bg-ic-blue',
    green: 'bg-ic-green',
    pink: 'bg-ic-pink',
    teal: 'bg-ic-teal'
};

const Tag = href ? 'a' : 'span';
---

<Tag
    href={href}
    class:list={[
        'border-ink text-ink inline-flex items-center rounded-full border-[1.5px] px-3.5 py-1 text-[13px] leading-normal font-bold',
        href && 'no-underline hover:underline',
        tones[tone]
    ]}
>
    <slot />
</Tag>
