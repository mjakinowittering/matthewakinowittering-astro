---
import { m } from '@paraglide/messages.js';
import '../styles/global.css';

interface metaTag {
    name: string;
    content: string;
}

interface metaData {
    title?: string;
    description?: string;
    additionalMetaTags?: Array<metaTag>;
}

interface Props {
    metaData: metaData;
}

function titleText(title: string | undefined) {
    return title ? m.site_title({ title, site }) : site;
}

const { metaData } = Astro.props;

const site = m.site_name();
---

<!doctype html>
<html lang="en-GB">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{titleText(metaData.title)}</title>
        <meta name="description" content={metaData.description} />
        {
            metaData.additionalMetaTags?.map((tag) => (
                <meta name={tag.name} content={tag.content} />
            ))
        }
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="bg-bg text-ink flex min-h-screen flex-col font-sans">
        <a
            href="#main"
            class="bg-accent text-accent-contrast sr-only rounded-lg text-sm font-bold no-underline focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-30 focus:px-5 focus:py-3"
        >
            {m.nav_skip_to_content()}
        </a>
        <slot name="header" />
        <main id="main" tabindex="-1" class="flex grow flex-col">
            <slot />
        </main>
        <slot name="footer" />
    </body>
</html>
