---
import { m } from '@paraglide/messages.js';
import '../styles/global.css';

interface metaTag {
    name: string;
    content: string;
}

interface metaData {
    title?: string;
    description?: string;
    additionalMetaTags?: Array<metaTag>;
    // Keeps the page out of search results and gives it no canonical URL
    noindex?: boolean;
}

interface Props {
    metaData: metaData;
}

function titleText(title: string | undefined) {
    return title ? m.site_title({ title, site }) : site;
}

const { metaData } = Astro.props;

const site = m.site_name();

const title = titleText(metaData.title);

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// The 1200 by 630 sharing card, public/og.png, drawn as
// docs/design/reference/og-image.html
const ogImage = new URL('/og.png', Astro.site).href;

const ogImageAlt = m.og_image_alt({ name: site });
---

<!doctype html>
<html lang="en-GB">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={metaData.description} />
        {
            metaData.noindex ? (
                <meta name="robots" content="noindex" />
            ) : (
                <link rel="canonical" href={canonical} />
            )
        }
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site} />
        <meta property="og:locale" content="en_GB" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaData.description} />
        {!metaData.noindex && <meta property="og:url" content={canonical} />}
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
        {
            metaData.additionalMetaTags?.map((tag) => (
                <meta name={tag.name} content={tag.content} />
            ))
        }
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Permanent+Marker&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-base text-ink flex min-h-dvh flex-col font-sans text-[16px] leading-[1.6]"
    >
        <a
            href="#main"
            class="bg-accent text-ink border-ink rounded-button sr-only border-[1.5px] text-sm font-bold no-underline focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-30 focus:px-5 focus:py-3"
        >
            {m.nav_skip_to_content()}
        </a>
        <slot name="header" />
        <main id="main" tabindex="-1" class="flex-1">
            <slot />
        </main>
        <slot name="footer" />
    </body>
</html>
